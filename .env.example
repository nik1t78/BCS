# ============================================================
# Скопируйте этот файл в .env  (в папке с docker-compose.yml)
# и задайте СВОИ значения. Никогда не коммитьте .env в git!
# Генерация паролей:  openssl rand -hex 16
# ============================================================

# --- Доступ к сайту для пользователей ---
# Сайт открывается по адресу вида http://10.48.4.235/ (БЕЗ порта в адресе):
# наружный порт Nginx зафиксирован в docker-compose.yml = 80 (стандартный HTTP).
# IP этой машины (для APP_URL Laravel, чтобы ссылки/редиректы были правильными):
SITE_IP=10.48.4.235
# 0.0.0.0 — доступ из локальной сети (нужно для пользователей);
# 127.0.0.1 — только с этой машины.
listen_ip=0.0.0.0

# --- Laravel ---
# Сгенерировать: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false

# --- MySQL ---
# ОБЯЗАТЕЛЬНО смените значения по умолчанию на боевом сервере!
# Генерация:  openssl rand -hex 16
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=vks_2026
DB_ROOT_PASSWORD=vks_2026_root

# --- Redis ---
REDIS_PASSWORD=vks_2026_redis

# --- VKS-бот (Selenium, автосоздание ссылок salutejazz.ru) ---
# Секретный токен для вызова бота (заголовок X-Bot-Token). На проде задайте!
BOT_TOKENS=
# Автоматическое создание ссылки через Selenium-бота ВЫКЛЮЧЕНО по умолчанию:
# контейнер vks-bot запускает Chromium (~0,8–1 ГБ RAM на время создания).
# Без него ссылка генерируется локально мгновенно в том же формате платформы.
# Чтобы включить бота: 1) поставьте VITE_VKS_AUTOBOT=1 (используется при
# сборке фронта), 2) запустите сервис: docker compose --profile bot up -d vks-bot
VITE_VKS_AUTOBOT=0
# ВАЖНО: если включаете бота (VITE_VKS_AUTOBOT=1), секрет в BOT_TOKENS
# автоматически передаётся во фронт при сборке (X-Bot-Token). После смены
# BOT_TOKENS нужно пересобрать фронт с --no-cache, иначе заголовок не обновится.

# --- Уведомления MAX (@masterbot) ---
# MESSENGER: max | none (none — полностью выключить рассылку)
MESSENGER=max
# Флаг включения доставки в MAX (без него уведомления НЕ отправляются!)
MAX_ENABLED=true
# Bot API MAX. ВНИМАНИЕ: сверьте адрес с документацией вашего бота @masterbot:
# https://maxapi.ru/v1 или https://max.ru (путь /sendmessage + Bearer-токен)
MAX_API_URL=https://maxapi.ru/v1
MAX_BOT_TOKEN=

# --- Уведомления Telegram (если MESSENGER=telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Прочее ---
# Часовой пояс для планировщика уведомлений
TZ=Europe/Moscow
