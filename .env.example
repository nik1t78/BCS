# ============================================================
# Скопируйте этот файл в .env  (в папке с docker-compose.yml)
# и задайте СВОИ значения. Никогда не коммитьте .env в git!
# Генерация паролей:  openssl rand -hex 16
# ============================================================

# --- Доступ к сайту для пользователей ---
# Сайт открывается по адресу вида http://10.48.4.235/ (БЕЗ порта в адресе):
# наружный порт Nginx зафиксирован в docker-compose.yml = 80 (стандартный HTTP).
# IP этой машины (для APP_URL Laravel, чтобы ссылки/редиректы были правильными):
SITE_IP=10.48.4.235
# 0.0.0.0 — доступ из локальной сети (нужно для пользователей);
# 127.0.0.1 — только с этой машины.
listen_ip=0.0.0.0

# --- Laravel ---
# Сгенерировать: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false

# --- MySQL ---
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=vks_2026
DB_ROOT_PASSWORD=vks_2026_root

# --- Redis ---
REDIS_PASSWORD=vks_2026_redis

# --- Уведомления MAX (@masterbot) ---
MESSENGER=max
MAX_BOT_TOKEN=
