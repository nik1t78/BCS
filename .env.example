# ============================================================
# Скопируйте этот файл в .env  (в папке с docker-compose.yml)
# и задайте СВОИ значения. Никогда не коммитьте .env в git!
# Генерация паролей:  openssl rand -hex 16
# ============================================================

# --- Доступ к сайту для пользователей ---
# Сайт открывается по адресу вида http://10.48.4.235/ (БЕЗ порта в адресе):
# наружный порт Nginx зафиксирован в docker-compose.yml = 80 (стандартный HTTP).
# IP этой машины (для APP_URL Laravel, чтобы ссылки/редиректы были правильными):
SITE_IP=10.48.4.244
# 0.0.0.0 — доступ из локальной сети (нужно для пользователей);
# 127.0.0.1 — только с этой машины.
# IP-адрес, на котором nginx слушает порт 80 (127.0.0.1 — доступ только с этой машины)
LISTEN_IP=0.0.0.0

# --- Laravel ---
# Сгенерировать: docker compose run --rm backend php artisan key:generate --show
# ОБЯЗАТЕЛЬНО заполните! Пустой/битый APP_KEY = HTTP 500 на всех /api/*
# (SESSION_DRIVER=cookie требует валидный ключ шифрования). Пример формата:
# APP_KEY=base64:FuNcoxHUUN9QMZe1oEDLSytyWtuLjmgurxN8IpmByek=
APP_KEY=
APP_ENV=production
APP_DEBUG=false
# Таймзона приложения. ДОЛЖНА совпадать с TZ контейнеров (Europe/Moscow):
# иначе now()/Carbon живут в UTC и сервер отклоняет корректное время как
# «прошедшее» (расхождение 3 часа). По умолчанию уже Europe/Moscow.
APP_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# --- MySQL ---
# Обязательны три РАЗНЫХ секрета (не используйте один пароль для всех сервисов).
# Генерация: openssl rand -hex 32
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- VKS-бот (SaluteJazz / Playwright) ---
# Секрет хранится только в backend и vks-bot; никогда не задавайте его как VITE_*.
BOT_TOKENS=
# Включайте true только при запущенном профиле bot и заданном BOT_TOKENS.
VKSBOT_EXPECTED=false
VKSBOT_AUTO=true
VKSBOT_CONCURRENCY=2
VKSBOT_QUEUE_LIMIT=20
# Laravel jobs выполняются асинхронно; два queue workers + два независимых browser workers.
QUEUE_CONNECTION=database
QUEUE_WORKERS=2
DB_QUEUE_RETRY_AFTER=300
VKSBOT_CHECK_MINUTES=60

# --- Уведомления MAX (@masterbot) ---
# MESSENGER: max | none (none — полностью выключить рассылку)
MESSENGER=max
# Флаг включения доставки в MAX (без него уведомления НЕ отправляются!)
MAX_ENABLED=true
# Bot API MAX. ВНИМАНИЕ: сверьте адрес с документацией вашего бота @masterbot:
# https://maxapi.ru/v1 или https://max.ru (путь /sendmessage + Bearer-токен)
MAX_API_URL=https://maxapi.ru/v1
MAX_BOT_TOKEN=
# Ссылка на чат бота MAX — кнопка «Написать боту в MAX» в профиле.
# Замените ID на реальный username/ID вашего бота из max.ru!
MAX_BOT_LINK=https://max.ru/id0070719725_bot

# --- Уведомления Telegram (если MESSENGER=telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Прочее ---
# Часовой пояс для планировщика уведомлений
TZ=Europe/Moscow

# Heartbeat воркера очереди (для «Статус системы» и system:monitor)
QUEUE_HEARTBEAT_INTERVAL=20
QUEUE_HEARTBEAT_MAX_AGE=180
