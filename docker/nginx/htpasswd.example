# Шаблон файла basic-auth для защиты эндпоинта /vks-bot/create.
# НЕ коммитьте реальный htpasswd в git!
#
# Создание реального файла (bcrypt-хеш пароля):
#   docker run --rm httpd:2-alpine htpasswd -Bbn "vksbot" "СУПЕР_ПАРОЛЬ" > docker/nginx/htpasswd
#
# Затем в default.conf:
#   auth_basic off;  ->  auth_basic "VKS bot";
#                       auth_basic_user_file /etc/nginx/.htpasswd;
# и в docker-compose.yml раскомментируйте монтирование ./docker/nginx/htpasswd.
