# Минимальный .env для сборки образа (php artisan package:discover в Dockerfile).
# Реальные значения приходят из docker-compose.yml (environment:) и не хранятся
# в образе — этот файл нужен только чтобы Laravel смог стартовать при build.
APP_NAME="VKS Schedule"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
