# Локальный запуск Laravel без Docker (для разработки)
APP_NAME="VKS Schedule"
APP_ENV=local
# Ключ генерируется автоматически скриптом setup-project.sh / .ps1
# (docker compose run --rm backend php artisan key:generate --show)
APP_KEY=
APP_DEBUG=true               # ТОЛЬКО в local! В production — false
APP_URL=http://10.48.4.235

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql   # для docker-compose; при локальном запуске без Docker: 127.0.0.1
DB_PORT=3306
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=vks_2026

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_DRIVER=file

# Ограничение частоты запросов и CORS
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Мессенджер MAX (Telegram удалён из проекта)
MESSENGER=max
MAX_BOT_TOKEN=
MAX_API_URL=https://max.ru
MAX_BOT_LINK=https://max.ru/masterbot
