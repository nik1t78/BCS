# Скопируйте этот файл в backend/.env (это делает setup-project.ps1).
# Значения БД/Redis должны совпадать с корневым .env рядом с docker-compose.yml.
APP_NAME="VKS Schedule"
APP_ENV=production
# Ключ генерируется автоматически скриптом setup-project.sh / .ps1
# (docker compose run --rm backend php artisan key:generate --show)
APP_KEY=
APP_DEBUG=false
# Сайт доступен пользователям по адресу вида http://10.48.4.235/ (порт 80 в URL не пишется)
APP_URL=http://10.48.4.235

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql   # имя сервиса в docker-сети; при локальном запуске без Docker: 127.0.0.1
DB_PORT=3306
DB_DATABASE=vks_schedule
DB_USERNAME=vks_user
DB_PASSWORD=vks_2026

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Очереди и кеш работают через Redis (контейнер vks-redis)
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=vks_2026_redis
REDIS_PORT=6379

# Домены/Origin должны совпадать с адресом, по которому сайт открывают
# пользователи (для порта 80 порт в origin не указывается).
# :5173 оставлен для dev-режима Vite.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,10.48.4.235
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://10.48.4.235

# Мессенджер MAX (Telegram удалён из проекта)
MESSENGER=max
MAX_BOT_TOKEN=
MAX_API_URL=https://max.ru
MAX_BOT_LINK=https://max.ru/masterbot
