
# Мессенджер для push-уведомлений: telegram | max | none
MESSENGER=telegram

# Telegram (Bot API) — основной канал уведомлений
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_LINK=https://t.me/Kolekt_bot
# Секрет для webhook: /api/telegram/webhook?secret=<значение>
TELEGRAM_WEBHOOK_SECRET=

# Мессенджер MAX (max.ru) — альтернативный канал (MESSENGER=max)
MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_API_URL=https://maxapi.ru/v1

# ================= Безопасность =================
# В продакшене обязательно: APP_ENV=production, APP_DEBUG=false
# (debug раскрывает стек-трейсы и конфигурацию наружу)
APP_ENV=production
APP_DEBUG=false
# Секрет генерировать на сервере: php artisan key:generate (никому не передавать)
APP_KEY=

# Токены Sanctum короткоживущие; refresh-токены — ротация + срок
SANCTUM_TOKEN_EXPIRATION=120
REFRESH_TOKEN_EXPIRATION_DAYS=14

# Куки/сессии: httpOnly+secure в проде (защита от XSS-кражи сессий)
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
COOKIE_SAMESITE=lax
