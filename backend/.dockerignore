# Файл без силы: compose-сервисы backend/queue/scheduler/backend-assets
# собираются с контекстом "." (корень репо) и dockerfile backend/Dockerfile,
# поэтому применяется ТОЛЬКО корневой .dockerignore. Оставлен как заглушка,
# чтобы случайная сборка `docker build ./backend` не тащила vendor/ и данные.
vendor
node_modules
.env
public/storage
storage/app/backups/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
*.log
*.tar.gz
*.tgz
*.zip
