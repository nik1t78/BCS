# Максимально уменьшаем контекст сборки: node_modules и артефакты не отправляются
# на docker-демон (иначе сборка frontend может занимать минуты и гигабайты RAM)
node_modules
dist
.git
docker/mysql/data
backend/vendor
backend/storage/logs
*.log
*.bundle
vks-bot
deploy
scripts
backend
.github
*.md
*.patch
.env
.env.*
!.env.example
# Vite-конфиг продакшена (VITE_API_URL=/api и т.д.) ОБЯЗАТЕЛЕН в контексте
# сборки frontend: без него `npm run build` внутри Docker теряет настройки из
# .env.production (правило `.env.*` выше его исключало). Секретов здесь нет —
# только публичные VITE_* переменные, которые всё равно вшиты в JS-бандл.
!.env.production
Dockerfile
docker-compose*.yml
setup-project.sh
start.sh
deploy.sh
*.tar.gz
*.tgz
*.zip

# Каркас Laravel-конфигов для стадии skeleton-stage (backend/Dockerfile,
# COPY --from=repo). По умолчанию всё содержимое docker/ уходит вместе с
# бинарниками/данными; возвращаем ТОЛЬКО *.php каркаса. Правила идут последними:
# в dockerignore "last match wins", перенос этих строк выше глобальных
# исключений молча выкинет каркас из контекста repo.
!docker/skeleton/laravel12/config/*.php
