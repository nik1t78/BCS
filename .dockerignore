# =============================================================================
# Контекст сборки = ВЕСЬ репозиторий (docker-compose.yml: context: .).
# Применяется и к frontend-образу (корневой Dockerfile), и к backend-образу
# (backend/Dockerfile) — поэтому НЕ исключаем ни src/, ни backend/, ни docker/.
# =============================================================================

# Гигантские/локальные артефакты — никогда не отправляем на демон
node_modules
**/node_modules
dist
**/dist
.git
.github
docker/mysql/data
*.log
*.bundle
*.tar.gz
*.tgz
*.zip

# Laravel: vendor собирается внутри образа (composer install), локальный не нужен
backend/vendor

# Локальные секреты и окружение (в образы попадают только явные примеры)
.env
.env.*
!.env.example
!.env.production
!.env.production.local
!.env.dev.example

# Сборочные скрипты, которым не место внутри образов
deploy
scripts
setup-project.sh
start.sh
deploy.sh

# vks-bot собирается отдельным контекстом (./vks-bot) — в общем не нужен
vks-bot

# Прочее
*.md
*.patch
