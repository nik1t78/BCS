node_modules/
*.bundle
# Laravel storage: логи, бэкапы БД (кроме .gitkeep)
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/storage/app/backups/*
!backend/storage/app/backups/.gitkeep
deploy/*.zip
# Данные MySQL-контейнера (дампы, сертификаты, биналоги) — не в Git
docker/mysql/data/*
!docker/mysql/data/.gitkeep
# Локальные резервные копии compose
*.old
# Прочее
.env
*.sql.gz
.DS_Store
Thumbs.db
