# Зависимости (устанавливаются при сборке, в git не хранятся)
node_modules/

# Артефакты сборки фронтенда (собираются Dockerfile-этапом builder)
dist/

# PHP-зависимости и lock Laravel (воспроизводятся composer install)
backend/vendor/
backend/composer.lock

# Логи, кэши, временные файлы
*.log
backend/storage/logs/
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
.vite/

# Секреты — никогда не коммитить
.env
.env.*
!backend/.env.example

# Системные файлы
.DS_Store
Thumbs.db
