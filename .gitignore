```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
htmlcov/
*.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.tox/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Distribution / packaging
.Python
env/
venv/
.venv/
.ENV
.venv.bak/
env.bak/

# Testing
test/
tests/
spec/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?
```