# *.gz более НЕ разрешены: phpredis скачивается с pecl.php.net внутри RUN,
# COPY tar.gz из контекста убран (лечит «failed to compute cache key ... not found»)
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.bundle

# Node_modules никогда не должен попадать в git — это раздувает репозиторий
# в ~200 МБ. Ставится командой: npm ci / npm install
node_modules/
backend/node_modules/
vks-bot/__pycache__/
__pycache__/
*.pyc
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
# phpredis-*.tar.gz больше НЕ нужен в git (Dockerfile не делает его COPY).
*.tar.bz2
*.tar.xz
*.tar.zst

# phpredis-архив больше не нужен в git: Dockerfile скачивает redis с pecl.php.net
backend/phpredis-6.3.0.tar.gz

# Данные MySQL (bind-mount из docker-compose) — никогда не коммитить
mysql/

# Локальные артефакты тестов/разработки (не коммитить)
backend/storage/framework/views/*.php
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/.gitkeep
backend/storage/logs/*.log
